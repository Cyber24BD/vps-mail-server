# Corporate Mail Platform - Environment Variables
# Used by Docker Compose & Deployment Scripts

# System Environment
ENVIRONMENT=production
NODE_ENV=production
DEBUG=false
TZ=UTC

# Host Configuration
SERVER_IP=127.0.0.1
CONTROL_PORT=7080
HTTP_PORT=80
HTTPS_PORT=443

# Modular Feature Toggles (Easily enable/disable components)
ENABLE_WEBMAIL=true
ENABLE_CLAMAV=true
ENABLE_RSPAMD=true
ENABLE_FAIL2BAN=true
ENABLE_BACKUPS=true
ENABLE_ALIASES=true
ENABLE_DIAGNOSTICS=true

# Security & Secrets
SECRET_KEY=change-me-to-a-super-secure-random-64-character-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=mailuser
POSTGRES_PASSWORD=supersecurepassword123
POSTGRES_DB=corpmail

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=supersecureredispassword123

# Mail Server General Settings
PRIMARY_HOSTNAME=mail.example.com
VMAIL_UID=5000
VMAIL_GID=5000
DEFAULT_QUOTA_MB=5120

# Rspamd
RSPAMD_PASSWORD=rspamdsecretpassword123

# ClamAV
CLAMAV_ENABLED=true

# Storage Paths on VPS Host
DATA_DIR=/var/mail-platform/data
MAIL_DIR=/var/mail-platform/vmail
DKIM_DIR=/var/mail-platform/dkim
SSL_DIR=/var/mail-platform/ssl
BACKUP_DIR=/var/mail-platform/backups
LOG_DIR=/var/mail-platform/logs
